{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "data/overtimegeneralvax.csv"
  },

  "transform": [
    {
      "filter": "datum.year == 2024 && datum.category == 'all children'"
    },
    {
      "calculate": "datum.age == 1 ? 0 : datum.age == 2 ? 1 : 2",
      "as": "age_pos"
    }
  ],

  "title": {
    "text": "Child Immune Parallel Coordinates"
  },

  "width": "container",
  "height": 260,

  "layer": [
    {
      "mark": "line",

      "encoding": {
        "x": {
          "field": "age_pos",
          "type": "quantitative",
          "scale": {
            "domain": [-0.2, 2.2]
          },
          "axis": null
        },

        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [87, 96]
          },
          "axis": null
        },

        "detail": {
          "field": "state_name"
        },

        "color": {
  "field": "state_name",
  "type": "nominal",
  "scale": {
    "range": [
  "steelblue",
  "darkorange",
  "crimson",
  "purple",
  "goldenrod",
  "slateblue",
  "deeppink",
  "saddlebrown"
]
  }
}
      }
    },

    {
      "mark": "rule",

      "encoding": {
        "x": {
          "field": "age_pos",
          "type": "quantitative",
          "scale": {
            "domain": [-0.2, 2.2]
          },
          "axis": null
        },

        "y": {
          "datum": 87,
          "scale": {
            "domain": [87, 96]
          }
        },

        "y2": {
          "datum": 96
        }
      }
    },

    {
      "data": {
        "values": [
          {"age_pos": 0, "value": 87},
          {"age_pos": 0, "value": 90},
          {"age_pos": 0, "value": 93},
          {"age_pos": 0, "value": 96},

          {"age_pos": 1, "value": 87},
          {"age_pos": 1, "value": 90},
          {"age_pos": 1, "value": 93},
          {"age_pos": 1, "value": 96},

          {"age_pos": 2, "value": 87},
          {"age_pos": 2, "value": 90},
          {"age_pos": 2, "value": 93},
          {"age_pos": 2, "value": 96}
        ]
      },

      "mark": "tick",

      "encoding": {
        "x": {
          "field": "age_pos",
          "type": "quantitative",
          "scale": {
            "domain": [-0.2, 2.2]
          },
          "axis": null
        },

        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [87, 96]
          }
        }
      }
    },

    {
      "data": {
        "values": [
          {"age_pos": 0, "value": 87},
          {"age_pos": 0, "value": 90},
          {"age_pos": 0, "value": 93},
          {"age_pos": 0, "value": 96},

          {"age_pos": 1, "value": 87},
          {"age_pos": 1, "value": 90},
          {"age_pos": 1, "value": 93},
          {"age_pos": 1, "value": 96},

          {"age_pos": 2, "value": 87},
          {"age_pos": 2, "value": 90},
          {"age_pos": 2, "value": 93},
          {"age_pos": 2, "value": 96}
        ]
      },

      "mark": {
        "type": "text",
        "dx": -10,
        "align": "right",
        "baseline": "middle"
      },

      "encoding": {
        "x": {
          "field": "age_pos",
          "type": "quantitative",
          "scale": {
            "domain": [-0.2, 2.2]
          },
          "axis": null
        },

        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [87, 96]
          }
        },

        "text": {
          "field": "value"
        }
      }
    },

    {
      "data": {
        "values": [
          {"age_pos": 0, "label": "1 year"},
          {"age_pos": 1, "label": "2 years"},
          {"age_pos": 2, "label": "5 years"}
        ]
      },

      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "baseline": "top"
      },

      "encoding": {
        "x": {
          "field": "age_pos",
          "type": "quantitative",
          "scale": {
            "domain": [-0.2, 2.2]
          },
          "axis": null
        },

        "y": {
          "value": 280
        },

        "text": {
          "field": "label"
        }
      }
    }
  ]
}