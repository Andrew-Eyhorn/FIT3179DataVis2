{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
"url": "../data/overtimegeneralvax.csv"
},
  "title": { "text": "Child Immune Slope Chart" },
  "transform": [
  { "filter": "datum.category == 'all children' && datum.age == 5" },
  { "filter": "datum.year == 2024 || datum.year == 2006" }
],
"width": "container",
"height": 260,
  "layer": [ {"mark": "line",
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "scale": {"padding": 0.5}
    },
    "y": {
      "field": "value",
      "type": "quantitative"
    },
    "color": {"field": "state_name", "type": "nominal"}
  }
},{
      "mark": {
        "type": "rule",
        "strokeDash": [6, 4],
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "datum": 95
        }
      }
    },{
    "mark": {
      "type": "text",
      "align": "left",
      "dx": 5,
      "dy": -5
    },
    "encoding": {
      "x": {"value": 0},
      "y": {"datum": 95},
      "text": {"value": "95% target"}
    }
  }
]}