{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
"url": "chart5/overtimegeneralvax.csv"
},
  "params": [
    {
      "name": "zoomedIn",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Focus view (75-100%): "
      }
    }
  ],
  "title": { "text": "Age-five coverage change by state, 2006-2024" },
  "transform": [
  { "filter": "datum.category == 'all children' && datum.age == 5" },
  { "filter": "datum.year == 2024 || datum.year == 2006" }
],
"width": "container",
"height": 260,
  "layer": [ {"mark": "line",
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "scale": {"padding": 0.5}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "Coverage (%)",
      "scale": {"domain": {"expr": "zoomedIn ? [75, 100] : [0, 100]"}}
    },
    "color": {
      "field": "state_name",
      "type": "nominal",
      "scale": {
        "range": ["#0072B2", "#E69F00", "#56B4E9", "#CC79A7", "#009E73", "#D55E00", "#6A3D9A", "#8C6D31"]
      },
      "legend": {"title": "State"}
    }
  }
},{
      "mark": {
        "type": "rule",
        "strokeDash": [6, 4],
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "datum": 95
        }
      }
    },
  {
    "data": {
      "values": [
        {"year": 2024, "value": 95.44, "label": "High: ACT 95.44%"},
        {"year": 2024, "value": 91.53, "label": "Low: NT 91.53%"}
      ]
    },
    "mark": {"type": "text", "align": "left", "dx": 6, "dy": -6, "fontSize": 10},
    "transform": [{"filter": "zoomedIn"}],
    "encoding": {
      "x": {"field": "year", "type": "ordinal"},
      "y": {"field": "value", "type": "quantitative"},
      "text": {"field": "label"}
    }
  },
  {
    "data": {"values": [{}]},
    "transform": [
      {"calculate": "zoomedIn ? 76 : 2", "as": "scale_label_y"}
    ],
    "mark": {"type": "text", "align": "left", "fontSize": 11, "color": "#555555"},
    "encoding": {
      "x": {"value": 0},
      "y": {"field": "scale_label_y", "type": "quantitative", "scale": {"domain": {"expr": "zoomedIn ? [75, 100] : [0, 100]"}}},
      "text": {
        "condition": {"test": "zoomedIn", "value": "Focused view: 75-100%"},
        "value": "Full scale: 0-100%"
      }
    }
  }
]}