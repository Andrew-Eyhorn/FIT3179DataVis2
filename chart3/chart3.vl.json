{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Child Immune All vs Indigineous" },
"width": "container",
"height": 260,
"data": {
"url": "data/overtimegeneralvax.csv"
},
"transform": [
  { "filter": "datum.year == 2024 && datum.state_name == 'Australia'" }
],
"mark": "bar",
"encoding": {
"xOffset": { "field": "category", "type": "ordinal" },
"y": { "field": "value", "type": "quantitative" },
"x": { "field": "age", "type": "nominal" },
"color": { "field": "category", "type": "ordinal" }
}
}