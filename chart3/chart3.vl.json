{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Coverage by Age and Population Group, 2024" },
"width": "container",
"height": 260,
"data": {
"url": "chart3/overtimegeneralvax.csv"
},
"transform": [
  { "filter": "datum.year == 2024 && datum.state_name == 'Australia'" }
],
"layer": [
  {
    "mark": "bar",
    "encoding": {
      "xOffset": { "field": "category", "type": "ordinal" },
      "y": { "field": "value", "type": "quantitative", "scale": {"domain": [0, 100]}, "title": "Coverage (%)" },
      "x": { "field": "age", "type": "nominal", "title": "Age (Years)" },
      "color": {
        "field": "category",
        "type": "nominal",
        "scale": {"domain": ["all children", "aboriginal"], "range": ["#0072B2", "#E69F00"]}
      }
    }
  },
  {
    "mark": {"type": "text", "dy": -6, "fontSize": 11},
    "encoding": {
      "xOffset": { "field": "category", "type": "ordinal" },
      "y": { "field": "value", "type": "quantitative", "scale": {"domain": [0, 100]}, "title": "Coverage (%)" },
      "x": { "field": "age", "type": "nominal", "title": "Age (Years)" },
      "text": {"field": "value", "type": "quantitative", "format": ".2f"}
    }
  }
]
}