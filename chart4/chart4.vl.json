{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Child Immune over Time" },
"width": "container",
"height": 260,
"data": {
"url": "data/overtimegeneralvax.csv"
},
"transform": [
  { "filter": "datum.category == 'all children' && datum.state_name == 'Australia'" }
],
"mark": "line",
"encoding": {
"x": { "field": "year", "type": "ordinal" },
"y": { "field": "value", "type": "quantitative" },
"color": { "field": "age", "type": "nominal" }
}
}