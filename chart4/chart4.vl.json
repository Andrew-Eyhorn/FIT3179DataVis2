{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "National coverage by age, 2006-2024", "fontSize": 17 },
"width": "container",
"height": 260,
"data": {
"url": "chart4/overtimegeneralvax.csv"
},
"params": [
  {
    "name": "zoomedIn",
    "value": false,
    "bind": {
      "input": "checkbox",
      "name": "Focus view (75-100%): "
    }
  }
],
"transform": [
  { "filter": "datum.category == 'all children' && datum.state_name == 'Australia'" }
],
"layer": [
  {
    "mark": "line",
    "encoding": {
      "x": { "field": "year", "type": "ordinal", "title": "Year" },
      "y": {
        "field": "value",
        "type": "quantitative",
        "title": "Coverage (%)",
        "scale": {"domain": {"expr": "zoomedIn ? [75, 100] : [0, 100]"}}
      },
      "color": {
        "field": "age",
        "type": "nominal",
        "scale": {"domain": [1, 2, 5], "range": ["#0072B2", "#CC79A7", "#E69F00"]},
        "legend": {"title": "Age (years)"}
      }
    }
  },
  {
    "mark": {"type": "rule", "strokeDash": [6, 4], "color": "#555555"},
    "encoding": {"y": {"datum": 95}}
  },
  {
    "data": {
      "values": [
        {"year": 2020, "value": 95.09, "label": "High: 95.09%"},
        {"year": 2024, "value": 90.44, "label": "Low: 90.44%"}
      ]
    },
    "mark": {"type": "text", "align": "left", "dx": 5, "dy": -8, "fontSize": 11},
    "transform": [{"filter": "zoomedIn"}],
    "encoding": {
      "x": {"field": "year", "type": "ordinal"},
      "y": {"field": "value", "type": "quantitative"},
      "text": {"field": "label"}
    }
  },
  {
    "data": {"values": [{}]},
    "transform": [
      {"calculate": "zoomedIn ? 76 : 2", "as": "scale_label_y"}
    ],
    "mark": {"type": "text", "align": "left", "fontSize": 11, "color": "#555555"},
    "encoding": {
      "x": {"value": 0},
      "y": {"field": "scale_label_y", "type": "quantitative", "scale": {"domain": {"expr": "zoomedIn ? [75, 100] : [0, 100]"}}},
      "text": {
        "condition": {"test": "zoomedIn", "value": "Focused view: 75-100%"},
        "value": "Full scale: 0-100%"
      }
    }
  }
]
}