{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "DTP3 coverage: Australia and supplier countries, 2025", "fontSize" : 16},
  "width": "container",
  "height": 260,
  "data": {
        "url": "chart8/vaccinedpt31yearcomparison.csv"
      },
  "mark": "bar",
  "encoding": {
    "x": {"field": "Country", "type": "nominal", "axis": {"labelAngle": 0, "title": "Country"}, "sort": "-y"},
    "y": {"field": "DTP3 coverage 1 year old 2025(%)", "type": "quantitative", "title": "DTP3 coverage (%)"},
    "color": {
          "condition": {
            "test": "datum.Country == 'Australia'",
            "value": "#ff9900"
          },
          "value": "#4682b4"
        },
          "tooltip": 
            [
              {"field": "Country", "type": "nominal", "title": "Country"},
              {"field": "DTP3 coverage 1 year old 2025(%)", "type": "quantitative", "title": "DTP3 coverage (%)", "format": ".2f"}
            ]

  }

}
