{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Age 1 DTP3 Coverage of Australia and Supplier Countries",
  "width": "container",
  "height": 260,
  "data": {
        "url": "chart8/vaccinedpt31yearcomparison.csv"
      },
  "mark": "bar",
  "encoding": {
    "x": {"field": "Country", "type": "nominal", "axis": {"labelAngle": 0}, "sort": "-y"},
    "y": {"field": "DTP3 coverage 1 year old 2025(%)", "type": "quantitative"},
    "color": {
          "condition": {
            "test": "datum.Country == 'Australia'",
            "value": "#ff9900"
          },
          "value": "#4682b4"
        },
          "tooltip": 
            [{"field": "Country", "type": "nominal"}, {"field": "DTP3 coverage age 1 2025(%)", "type": "quantitative"}]

  }

}

