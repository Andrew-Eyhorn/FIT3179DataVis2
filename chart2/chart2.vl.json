{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Age-five coverage by PHN, 2025", "fontSize": 17},
  "width": "container",
  "height": 260,

  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "Population_Above",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2000000,
        "step": 10000,
        "name": "Minimum Population: "
      }
    }],
  "layer": [
    {
      "data": {
        "url": "chart2/chart2testgeophnbound.topojson",
        "format": {
          "type": "topojson",
          "feature": "PHN_202308_AUST_GDA2020"
        }
      },

      "transform": [
        {
          "lookup": "properties.PHN_CODE",
          "from": {
            "data": {
              "url": "chart2/chart2data.csv"
            },
            "key": "phn_code",
            "fields": ["population", "% 5 year olds vaccinated children", "latitude", "longitude"]
          },
          "as": ["Population", "Value", "Latitude", "Longitude"]
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },

    {
      "data": {
        "url": "chart2/chart2data.csv"
      },
      "transform": [{"filter": "datum.population > Population_Above"}],
      "mark": {
        "type": "square",
        "tooltip": {
          "content": "data"
        }
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "population",
          "type": "quantitative",
          "title": "Population"
        },
        "color": {
          "field": "% 5 year olds vaccinated children",
          "type": "quantitative",
          "title": "Coverage (%)",
          "scale": {
            "scheme": "blues",
            "domain": [88, 98]
          }
        },

        "tooltip": [
          {"field": "phn_code", "title": "PHN code"},
          {"field": "phn_name", "title": "PHN name"},
          {"field": "population", "title": "Population", "format": ","},
          {"field": "% 5 year olds vaccinated children", "title": "Coverage (%)", "format": ".2f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 148.25, "latitude": -32.8, "label_longitude": 145.8, "label_latitude": -31.7, "population": 315382, "label": "Western NSW 96.07%"},
          {"longitude": 152.7, "latitude": -29.6, "label_longitude": 160.0, "label_latitude": -28.7, "population": 557038, "label": "North Coast 88.00%"},
          {"longitude": 153.35, "latitude": -28.05, "label_longitude": 161.7, "label_latitude": -27.3, "population": 698017, "label": "Gold Coast 89.12%"},
          {"longitude": 151.5, "latitude": -25.8, "label_longitude": 154.0, "label_latitude": -24.8, "population": 970173, "label": "Central Qld, Wide Bay, Sunshine Coast 89.20%"}
        ]
      },
      "transform": [{"filter": "datum.population > Population_Above"}],
      "mark": {
        "type": "text",
        "fontSize": 8,
        "fontWeight": "bold",
        "dy": -10
      },
      "encoding": {
        "longitude": {"field": "label_longitude", "type": "quantitative"},
        "latitude": {"field": "label_latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 148.25, "latitude": -32.8, "label_longitude": 145.8, "label_latitude": -31.7, "population": 315382},
          {"longitude": 152.7, "latitude": -29.6, "label_longitude": 160.0, "label_latitude": -28.7, "population": 557038},
          {"longitude": 153.35, "latitude": -28.05, "label_longitude": 161.7, "label_latitude": -27.3, "population": 698017},
          {"longitude": 151.5, "latitude": -25.8, "label_longitude": 154.0, "label_latitude": -24.8, "population": 970173}
        ]
      },
      "transform": [{"filter": "datum.population > Population_Above"}],
      "mark": {"type": "rule", "stroke": "#555555", "strokeWidth": 0.8},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "longitude2": {"field": "label_longitude"},
        "latitude2": {"field": "label_latitude"}
      }
    }
  ]
}