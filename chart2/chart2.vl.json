{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Child Immunisation Age 5 By Phn 2025",
  "width": "container",
  "height": 260,

  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "Population_Above",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2000000,
        "step": 10000,
        "name": "Minimum Population: "
      }
    }],
  "layer": [
    {
      "data": {
        "url": "chart2/chart2testgeophnbound.topojson",
        "format": {
          "type": "topojson",
          "feature": "PHN_202308_AUST_GDA2020"
        }
      },

      "transform": [
        {
          "lookup": "properties.PHN_CODE",
          "from": {
            "data": {
              "url": "chart2/chart2data.csv"
            },
            "key": "phn_code",
            "fields": ["population", "% 5 year olds vaccinated children", "latitude", "longitude"]
          },
          "as": ["Population", "Value", "Latitude", "Longitude"]
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },

    {
      "data": {
        "url": "chart2/chart2data.csv"
      },
      "transform": [{"filter": "datum.population > Population_Above"}],
      "mark": {
        "type": "square",
        "tooltip": {
          "content": "data"
        }
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "population",
          "type": "quantitative",
          "title": "Population"
        },
        "color": {
          "field": "% 5 year olds vaccinated children",
          "type": "quantitative",
          "title": "% Vaccinated",
          "scale": {
            "scheme": "reds"
          }
        },

        "tooltip": [
          {
            "field": "PHN_Code",
            "title": "PHN Code"
          },
          {
            "field": "PHN_Name",
            "title": "PHN Name"
          },
          {
            "field": "Test_Population",
            "title": "Test Population"
          },
          {
            "field": "Value",
            "title": "Value"
          }
        ]
      }
    }
  ]
}