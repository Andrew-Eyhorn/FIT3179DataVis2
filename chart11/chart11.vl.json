{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Aboriginal and overall age-five coverage by PHN, 2025",
    "subtitle": "Points above the diagonal have higher Aboriginal coverage than overall coverage.",
    "fontSize": 16
  },
  "width": "container",
  "height": 280,
  "data": {"url": "chart11/vacc2025perphn5yaer.csv"},
  "params": [
    {
      "name": "Population_Above",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2000000,
        "step": 10000,
        "name": "Minimum Population: "
      }
    }],
  "layer": [
    {
      "transform": [{"filter": "datum.population > Population_Above"}],
      "mark": "circle",
      "encoding": {
    "x": {
      "field": "% 5 year olds vaccinated children",
      "type": "quantitative",
      "scale": {"domain": [86, 100]},
      "title": "Overall coverage (%)"
    },
    "y": {
      "field": "% 5 year olds vaccinated aboriginal",
      "type": "quantitative",
      "scale": {"domain": [86, 100]},
      "title": "Aboriginal coverage (%)"
    },
    "size": {"field": "population", "type": "quantitative"},
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {"domain": ["Metropolitan", "Regional"], "range": ["#0072B2", "#CC79A7"]},
      "legend": {"title": "Area type"}
    },
     "tooltip": [
      {
        "field": "phn_name",
        "title": "PHN Name"
      },
      {
        "field": "% 5 year olds vaccinated children",
        "title": "Overall coverage (%)",
        "format": ".2f"
      },
      {
        "field": "% 5 year olds vaccinated aboriginal",
        "title": "Aboriginal coverage (%)",
        "format": ".2f"
      },
      {
        "field": "population",
        "title": "Population",
        "format": ","
      }
      ]
      }
    },
    {
      "data": {"values": [{"x": 86, "y": 86}, {"x": 100, "y": 100}]},
      "mark": {"type": "line", "strokeDash": [5, 4], "color": "#555555"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [86, 100]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [86, 100]}}
      }
    },
    {
      "data": {
        "values": [
          {"x": 93.91, "y": 86.15, "population": 963869, "label": "Northern Sydney: 86.15% vs 93.91%"}
        ]
      },
      "transform": [{"filter": "datum.population > Population_Above"}],
      "mark": {"type": "text", "align": "left", "dx": 5, "dy": -7, "fontSize": 10},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [86, 100]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [86, 100]}},
        "text": {"field": "label"}
      }
    }
  ]
}