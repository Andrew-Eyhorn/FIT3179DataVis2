{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "chart10data.csv"},
  "mark": "rect",
  "title": "Per vaccine per phn in 2025 % immune",
  "transform": [
  {
    "fold": [
      "% DTP",
      "% Polio",
      "% HIB",
      "% HEP",
      "% MMR",
      "% Pneumo",
      "% MenC",
      "% Varicella"
    ],
    "as": ["Vaccine", "Coverage"]
  },
  {
    "calculate": "replace(datum.Coverage, '%', '')",
    "as": "CoverageNum"
  },
  {
    "calculate": "toNumber(datum.CoverageNum)",
    "as": "Coverage"
  }
],
  "encoding": {
  "x": {
    "field": "Vaccine",
    "type": "nominal",
    "sort": [
      "% DTP",
      "% Polio",
      "% HIB",
      "% HEP",
      "% MMR",
      "% Pneumo",
      "% MenC",
      "% Varicella"
    ]
  },
  "y": {
    "field": "PHN Name",
    "type": "nominal"
  },
  "color": {
    "field": "Coverage",
    "type": "quantitative",
    "scale": {
      "domain": [80, 100]
    }
  },
  "tooltip": [
    {"field": "PHN Name", "type": "nominal"},
    {"field": "Vaccine", "type": "nominal"},
    {"field": "Coverage", "type": "quantitative", "format": ".2f"}
  ]
}
}