{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "chart10/chart10data.csv"},
  "width": "container",
  "height": 520,
  "title": {"text": "Two-year-old vaccination coverage by vaccine and PHN, 2025"},
  "transform": [
  {
    "fold": [
      "% DTP",
      "% Polio",
      "% HIB",
      "% HEP",
      "% MMR",
      "% Pneumo",
      "% MenC",
      "% Varicella"
    ],
    "as": ["Vaccine", "Coverage"]
  },
  {
    "calculate": "replace(datum.Coverage, '%', '')",
    "as": "CoverageNum"
  },
  {
    "calculate": "toNumber(datum.CoverageNum)",
    "as": "Coverage"
  }
],
  "encoding": {
  "x": {
    "field": "Vaccine",
    "type": "nominal",
    "title": "Vaccine",
    "axis": {
      "title": "Vaccine",
      "labelExpr": "replace(datum.label, '% ', '')",
      "labelAngle": -45,
      "labelOverlap": false
    },
    "sort": [
      "% DTP",
      "% Polio",
      "% HIB",
      "% HEP",
      "% MMR",
      "% Pneumo",
      "% MenC",
      "% Varicella"
    ]
  },
  "y": {
    "field": "PHN Name",
    "type": "nominal",
    "title": "PHN",
    "axis": {
      "title": "Primary Health Network (PHN)",
      "labelFontSize": 9,
      "labelLimit": 300,
      "labelExpr": "datum.label == 'Central Queensland, Wide Bay and Sunshine Coast' ? 'Central Qld, Wide Bay and Sunshine Coast' : datum.label",
      "labelPadding": 4,
      "labelOverlap": false
    }
  },
  "color": {
    "field": "Coverage",
    "type": "quantitative",
    "title": "Coverage (%)",
    "scale": {
      "domain": [80, 100],
      "scheme": "blues"
    }
  },
  "tooltip": [
    {"field": "PHN Name", "type": "nominal", "title": "PHN"},
    {"field": "Vaccine", "type": "nominal", "title": "Vaccine"},
    {"field": "Coverage", "type": "quantitative", "title": "Coverage (%)", "format": ".2f"}
  ]
  },
  "layer": [
    {"mark": "rect"},
    {
      "transform": [
        {
          "filter": "(datum.Vaccine == '% HEP' && datum['PHN Name'] == 'Western NSW') || (datum.Vaccine == '% MMR' && datum['PHN Name'] == 'North Coast') || (datum.Vaccine == '% Varicella' && datum['PHN Name'] == 'North Coast')"
        },
        {
          "calculate": "format(datum.Coverage, '.2f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#222222"
      },
      "encoding": {
        "text": {"field": "label"},
        "color": {"value": "#222222"}
      }
    }
  ]
}