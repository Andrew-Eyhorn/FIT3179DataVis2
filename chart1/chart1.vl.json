{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Age-Five Coverage by State, 2024"},
  "width": "container",
  "height": 320,

  "projection": {
    "type": "mercator"
  },

  "data": {
    "url": "chart1/chart1geodata.topojson",
    "format": {
      "type": "topojson",
      "feature": "STE_2021_AUST_GDA2020"
    }
  },

  "transform": [
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": {
          "url": "chart1/chart1data.csv"
        },
        "key": "State Name",
        "fields": ["Value"]
      },
      "as": "coverageValue"
    }
  ],

  "layer": [
    {
      "mark": "geoshape",
      "encoding": {
        "color": {
          "field": "coverageValue",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [90, 96]
          }
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "title": "State"
          },
          {
            "field": "coverageValue",
            "title": "Coverage (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"longitude": 149.1, "latitude": -35.45, "label": "ACT 95.44%"},
          {"longitude": 133, "latitude": -19.5, "label": "NT 91.53%"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "dy": -8
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}