{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Child Immunisation Age 5 By State",
  "width": 800,
  "height": 400,

  "projection": {
    "type": "mercator"
  },

  "data": {
    "url": "chart1geodata.topojson",
    "format": {
      "type": "topojson",
      "feature": "STE_2021_AUST_GDA2020"
    }
  },

  "transform": [
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": {
          "url": "chart1data.csv"
        },
        "key": "GeographicAreaName",
        "fields": ["Value"]
      },
      "as": "immunisationValue"
    }
  ],

  "mark": "geoshape",

  "encoding": {
    "color": {
      "field": "immunisationValue",
      "type": "quantitative"
    },

    "tooltip": [
      {
        "field": "properties.STE_NAME21",
        "title": "State"
      },
      {
        "field": "immunisationValue",
        "title": "Immunisation"
      }
    ]
  }
}